NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# New-lead email notifications (server-only).
GMAIL_USER=sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# Separate multiple recipients with commas.
NOTIFICATION_EMAIL=owner@example.com,assistant@example.com

# Legacy owner allowlist. New staff roles should be assigned in Supabase
# Authentication user app_metadata instead of adding individual emails here.
SUPABASE_ADMIN_EMAILS=owner@example.com

# Legacy fallback for planners who have not yet been assigned an app_metadata role.
SUPABASE_PLANNER_EMAILS=planner@example.com

# Legacy fallback for inquiry staff who have not yet been assigned an app_metadata role.
SUPABASE_INQUIRY_STAFF_EMAILS=inquiries@example.com

# Optional local-only shortcut. Leave false to test the real admin login and sign-out flow.
ADMIN_DEV_BYPASS=false

# Design Consultation webhook (server-only; never NEXT_PUBLIC)
CALENDLY_API_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_DESIGN_CONSULTATION_EVENT_TYPE_URI=
# Setup script only: https://YOUR-PRODUCTION-DOMAIN/api/webhooks/calendly
CALENDLY_WEBHOOK_URL=

# Lead tracking step 7: Meta (see docs/lead-tracking-playbook/README.md)
# 7a spend import: system-user token with ads_read on the ad account.
META_ADS_READ_TOKEN=
META_AD_ACCOUNT_ID=55657071
# 7b Conversions API: token from Events Manager → dataset → Settings.
META_CAPI_TOKEN=
META_PIXEL_ID=1263840655319183
# Optional: Events Manager → Test events code, to see events there while testing.
META_CAPI_TEST_CODE=
# Optional: override the Graph API version (default v26.0).
META_GRAPH_VERSION=
# Vercel sends this to /api/cron/meta-spend; any long random string.
CRON_SECRET=

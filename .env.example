NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# New-lead email notifications (server-only).
GMAIL_USER=sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# Separate multiple recipients with commas.
NOTIFICATION_EMAIL=owner@example.com,assistant@example.com

# Comma-separated email addresses allowed into the private studio.
SUPABASE_ADMIN_EMAILS=owner@example.com
